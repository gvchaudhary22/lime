# MARS Go backend — existing.
NEXT_PUBLIC_API_URL=http://localhost:8080

# aiplatformkb FastAPI backend — read-only PR Feed API + public tools.json
# (auth-less). See docs/specs/pr-feed-api-contract.md in the aiplatformkb repo.
NEXT_PUBLIC_AIPLATFORMKB_URL=http://localhost:8000

# Phase 13 Wave 1C — server-side admin proxy.
# Used by /api/aiplatformkb/admin/[...path] to forward /admin/* calls upstream
# with `Authorization: Bearer <token>` injected. Token never reaches the
# browser. Must match aiplatformkb's AIPLATFORMKB_ADMIN_TOKEN exactly.
# Leave unset to disable the proxy (every admin request returns 503).
AIPLATFORMKB_ADMIN_TOKEN=
# Optional override for the upstream — used when Lime runs in a deploy where
# the browser-facing aiplatformkb URL differs from the server-to-server one.
# Defaults to NEXT_PUBLIC_AIPLATFORMKB_URL when unset.
AIPLATFORMKB_URL=

# Phase 4 (ai-platform migration) — server-side ai-platform admin proxy.
# Used by /api/ai-platform/[...path] to forward versioned admin calls
# (e.g. /v1/admin/knowledgebase/{platforms,modules}) to the ai-platform
# FastAPI service with `Authorization: Bearer <token>` injected. Token
# never reaches the browser. Must match ai-platform's
# `ai_platform_admin_token` server setting exactly.
AI_PLATFORM_ADMIN_TOKEN=
# Server-to-server URL for the ai-platform service. Defaults to
# http://localhost:8000 when unset (same dev port as aiplatformkb — only one
# of the two runs locally at a time).
AI_PLATFORM_URL=
